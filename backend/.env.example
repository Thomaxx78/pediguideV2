# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=3000

# ── Base de données (Supabase PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── JWT (générer avec : openssl rand -hex 32) ────────────────────────────────
JWT_SECRET=changez-moi-avec-une-cle-aleatoire-de-64-caracteres

# ── Frontend (pour CORS) ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── IA — Groq ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Email — mode développement ───────────────────────────────────────────────
# Si true, le helper email ne contacte pas Resend et logue dans la console.
# Pratique pour itérer sur la cron de relances sans bouffer le quota Resend.
EMAIL_DEV_MODE=false

# ── Cron — relances parent automatiques ──────────────────────────────────────
# Secret partagé avec GitHub Actions (workflow reminders-cron.yml).
# Générer avec : openssl rand -hex 32
CRON_SECRET=...

# ── KYC — Didit ──────────────────────────────────────────────────────────────
DIDIT_APP_ID=
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
